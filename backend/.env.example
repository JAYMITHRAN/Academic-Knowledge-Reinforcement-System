# ─────────────────────────────────────────
# AKRS Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────
# MySQL Database (local)
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sruthi
DB_NAME=akrs_db
# Set DB_SSL=true only if your MySQL server requires SSL
DB_SSL=false

# ─────────────────────────────────────────
# Default Admin Account (auto-seeded on first startup)
# Use the exact Google email you will sign in with
# ─────────────────────────────────────────
ADMIN_EMAIL=radan2.g@gmail.com
ADMIN_NAME=System Admin

# ─────────────────────────────────────────
# Firebase Admin SDK
# From Firebase Console → Project Settings → Service Accounts
# → Generate new private key
# ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─────────────────────────────────────────
# Frontend URL (for CORS)
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
